{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "productivitwo-app",
          "appId": "1:752644759129:android:291bdc6c171092bf411b48",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "productivitwo-app",
          "configurations": {
            "ios": "1:752644759129:ios:a108b3fc11c5e72c411b48",
            "web": "1:752644759129:web:871009d70bcc1053411b48"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "productivitwo-app",
          "appId": "1:752644759129:ios:a108b3fc11c5e72c411b48",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/main.dart.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
      },
      {
        "source": "/manifest.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      { "source": "/mcp/**", "run": { "serviceId": "mcphandler", "region": "us-central1" } },
      { "source": "/vision", "destination": "/formation.html" },
      { "source": "/vision/", "destination": "/formation.html" },
      { "source": "/formation", "destination": "/formation.html" },
      { "source": "/formation/", "destination": "/formation.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": ["node_modules", ".git", "src"]
  }
}
