rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Statut d'accès/Pro : l'utilisateur lit le sien (écrit uniquement côté serveur).
    match /formation_access/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // ── Couche sociale/jeu supprimée (pivot productivité) ────────────────────
    // Les règles des collections publiques du jeu (profiles, pseudos,
    // leaderboard_entries, challenge_library, challenge_submissions,
    // world_nuisibles, battles, invasions, territories) ont été retirées :
    // sans règle explicite, tout accès client est refusé par défaut.
    // Anciennes règles récupérables sur archive/couche-jeu-complete-2026-07.
  }
}
