rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Statut d'accès/Pro : l'utilisateur lit le sien (écrit uniquement côté serveur).
    match /formation_access/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // ── Couche sociale (Phase 1) ─────────────────────────────────────────────
    // Lecture publique des profils/classements opt-in ; écriture serveur only.
    match /profiles/{uid} {
      allow read: if resource.data.optedIn == true;
      allow write: if false;
    }
    match /pseudos/{p} {
      allow read: if true;   // vérifier la dispo d'un pseudo
      allow write: if false;
    }
    match /leaderboard_entries/{uid} {
      allow read: if resource.data.optedIn == true;
      allow write: if false;
    }
    // Bibliothèque de challenges (Phase 2) : lecture publique des approuvés ;
    // écriture serveur only (super-Orion). Soumissions : créées par l'auteur.
    match /challenge_library/{id} {
      allow read: if resource.data.status == 'approved';
      allow write: if false;
    }
    match /challenge_submissions/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
